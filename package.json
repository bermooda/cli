{
  "name": "@bermooda/cli",
  "version": "1.1.0",
  "description": "CLI for scaffolding and managing bermooda ecommerce shops",
  "type": "module",
  "bin": {
    "bermooda": "./src/cli.js"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bermooda/cli.git"
  },
  "homepage": "https://github.com/bermooda/cli",
  "bugs": "https://github.com/bermooda/cli/issues",
  "keywords": [
    "bermooda",
    "ecommerce",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.1",
    "citty": "^0.2.2",
    "dotenv": "^17.4.2",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "vitest": "^4.1.10"
  }
}
